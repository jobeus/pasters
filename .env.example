# Copy to .env (git-ignored). On grizzly it is /srv/apps/pasters/shared/.env (600),
# linked into each release and loaded by start.sh.
# Real environment variables override these. For local dev, .env.development (or
# .env.<PASTE_ENV>) is also read and overrides .env.

# Logfire write token; leave unset to log to the console only.
LOGFIRE_API_KEY=

# PASTE_ADDR=127.0.0.1:8000   (on grizzly the unit sets APP_SOCKET and it listens there instead)
# PASTE_DATA=data
# PASTE_BASE_URL=https://paste.example.com
# PASTE_TRUST_PROXY=1
# PASTE_RATE_LIMIT=10
# RUST_LOG=info
