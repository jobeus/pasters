# Copy to .env (git-ignored; chmod 600 on the server, where start.sh loads it).
# Real environment variables override these. For local dev, .env.development (or
# .env.<PASTE_ENV>) is also read and overrides .env.

# Logfire write token; leave unset to log to the console only.
LOGFIRE_API_KEY=

# PASTE_ADDR=127.0.0.1:8000
# PASTE_DATA=data
# PASTE_BASE_URL=https://paste.example.com
# PASTE_TRUST_PROXY=1
# PASTE_RATE_LIMIT=10
# RUST_LOG=info

# Deploy webhook (see README). Empty secret = disabled.
# DEPLOY_WEBHOOK_SECRET=
# DEPLOY_WEBHOOK_HOST=127.0.0.1   (default; 0.0.0.0 to expose directly)
# DEPLOY_WEBHOOK_PORT=8787
# DEPLOY_BUILD_COMMAND=scripts/release-build.sh
