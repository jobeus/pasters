# systemd unit for pasters on grizzly (paste.jobe.wtf). Install, as jobe in the checkout:
#   sudo install -m 644 deploy/pasters.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now pasters
# Logs: journalctl -u pasters -f
# Apache (paste.jobe.wtf) proxies to 127.0.0.1:8000; deploy hook on 127.0.0.1:8787.

[Unit]
Description=pasters pastebin (paste.jobe.wtf)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=jobe
Group=jobe
WorkingDirectory=/home/jobe/webs/paste.jobe.wtf
# start.sh loads .env, builds, and relaunches on exit 42 (deploy webhook);
# systemd covers crashes and reboots.
ExecStart=/home/jobe/webs/paste.jobe.wtf/start.sh
Restart=always
RestartSec=5
# pasters drains in-flight requests and flushes Logfire on SIGTERM.
KillSignal=SIGTERM
TimeoutStopSec=30
SyslogIdentifier=pasters
NoNewPrivileges=true
PrivateTmp=true
# Rust: cargo lives in ~/.cargo/bin (start.sh and the deploy hook both run it).
Environment=PATH=/home/jobe/.cargo/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=multi-user.target
